APP_NAME=Plannify
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ------------------------
# DATABASE (Docker MySQL)
# ------------------------

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=plannify
DB_USERNAME=plannify
DB_PASSWORD=plannify

# ------------------------
# SESSION / CACHE
# (file driver avoids DB dependency before migration)
# ------------------------

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file

QUEUE_CONNECTION=sync

# ------------------------
# LOGGING
# ------------------------

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ------------------------
# MAIL (log only for dev)
# ------------------------

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
